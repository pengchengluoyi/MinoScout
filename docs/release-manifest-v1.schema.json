{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mino release manifest schema 1",
  "type": "object",
  "required": [
    "manifest_schema_version",
    "component",
    "version",
    "build_id",
    "source_commit",
    "compatibility",
    "items"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": 1
    },
    "component": {
      "enum": [
        "nexus",
        "scout",
        "workbench"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "runtime",
        "protocol",
        "api",
        "schema",
        "automatic_rollback"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "os",
          "arch",
          "filename",
          "sha256",
          "bytes"
        ],
        "properties": {
          "os": {
            "enum": [
              "darwin",
              "linux",
              "win32",
              "any"
            ]
          },
          "arch": {
            "enum": [
              "arm64",
              "x64",
              "any"
            ]
          },
          "filename": {
            "type": "string",
            "pattern": "^[^/\\\\]+$",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/[^/]+/[^/]+$"
          },
          "layers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "key",
                "filename",
                "sha256",
                "bytes"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "filename": {
                  "type": "string",
                  "pattern": "^[^/\\\\]+$",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "distribution",
        "publishable"
      ],
      "properties": {
        "distribution": {
          "const": "local-verification"
        },
        "publishable": {
          "const": false
        }
      }
    },
    {
      "not": {
        "required": [
          "distribution"
        ]
      },
      "properties": {
        "items": {
          "items": {
            "required": [
              "url"
            ]
          }
        }
      }
    }
  ]
}
